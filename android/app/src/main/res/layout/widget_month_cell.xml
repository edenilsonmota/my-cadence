<?xml version="1.0" encoding="utf-8"?>
<!-- Um dia da grade mensal: número (com círculo quando é hoje) e até 3 pontinhos. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/month_cell_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1">

    <ImageView
        android:id="@+id/month_cell_today"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center_horizontal|top"
        android:contentDescription="@null"
        android:src="@drawable/widget_circle"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/month_cell_day"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="5dp"
            android:layout_marginTop="1dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/month_cell_dot1"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_circle"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/month_cell_dot2"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_circle"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/month_cell_dot3"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_circle"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
