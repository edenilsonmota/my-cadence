<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="34dp"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <ImageView
        android:id="@+id/widget_today_item_bar"
        android:layout_width="4dp"
        android:layout_height="24dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bar" />

    <TextView
        android:id="@+id/widget_today_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F3F4F6"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_today_item_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Concluir: abre o app já concluindo (cadence://complete/<id>). -->
    <ImageView
        android:id="@+id/widget_today_item_check"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/widget_complete_task"
        android:padding="6dp"
        android:src="@drawable/ic_widget_check" />
</LinearLayout>
